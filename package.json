{
  "name": "@shelf-ui/react",
  "version": "0.3.0",
  "description": "Shelf UI — off-the-shelf, accessible React components with design tokens and dark mode.",
  "keywords": [
    "react",
    "ui",
    "components",
    "design-system",
    "accessible",
    "shelf-ui"
  ],
  "author": "Shelf UI contributors",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ChandraPrakashSingh00/shelf-ui.git"
  },
  "homepage": "https://www.shelfui.chandradev.in",
  "bugs": {
    "url": "https://github.com/ChandraPrakashSingh00/shelf-ui/issues"
  },
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "module": "./dist/index.js",
  "exports": {
    ".": {
      "import": "./dist/index.js"
    },
    "./styles.css": "./dist/styles.css",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "CHANGELOG.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": ">=22.22.0",
      "onFail": "warn"
    }
  },
  "scripts": {
    "dev": "vite --config docs/vite.config.js --open",
    "playground": "vite --open",
    "build": "vite build && node scripts/verify-dist.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint . --max-warnings=0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "docs:dev": "vite --config docs/vite.config.js",
    "docs:build": "vite build --config docs/vite.config.js && node scripts/verify-docs.mjs",
    "docs:preview": "vite preview --config docs/vite.config.js",
    "prepublishOnly": "npm run lint && npm run test && npm run build"
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@vitejs/plugin-react": "^6.1.1",
    "eslint": "^10.11.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.12.0",
    "jsdom": "^29.1.1",
    "prettier": "^3.9.9",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router": "^8.4.0",
    "vite": "^8.3.1",
    "vitest": "^5.0.2"
  }
}
