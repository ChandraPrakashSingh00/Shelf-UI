{
  "name": "@codecps/ui",
  "version": "0.1.0",
  "description": "CodeCPS UI — accessible React component library by CodeCPS Technologies.",
  "keywords": [
    "react",
    "ui",
    "components",
    "design-system",
    "accessible",
    "codecps"
  ],
  "author": "CodeCPS Technologies",
  "license": "MIT",
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "module": "./dist/index.js",
  "exports": {
    ".": {
      "import": "./dist/index.js"
    },
    "./styles.css": "./dist/styles.css",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "CHANGELOG.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": ">=22.22.0",
      "onFail": "warn"
    }
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build && node scripts/verify-dist.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "docs:dev": "vite --config docs/vite.config.js",
    "docs:build": "vite build --config docs/vite.config.js",
    "docs:preview": "vite preview --config docs/vite.config.js",
    "prepublishOnly": "npm run test && npm run build"
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@vitejs/plugin-react": "^6.1.1",
    "jsdom": "^29.1.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router": "^8.4.0",
    "vite": "^8.3.1",
    "vitest": "^5.0.2"
  }
}
